# Copy to .env and `source .env`. The tool reads these from the environment,
# it does not auto-load .env.

# Direct provider keys, read by each SDK:
ANTHROPIC_API_KEY=your_key_here   # --provider anthropic
OPENAI_API_KEY=your_key_here      # --provider openai

# Primary model backend. Generic overrides used as defaults for
# --provider / --api-base / --api-key / --model.
# Handy for a LiteLLM proxy: set these and run `codejury review diff --provider litellm`.
CODEJURY_PROVIDER=anthropic       # anthropic, openai, or litellm. Default anthropic.
CODEJURY_API_BASE=https://your-litellm-proxy
CODEJURY_API_KEY=your_key_here
CODEJURY_MODEL=your-model-alias

# Secondary model, Repo Review only. A second, deliberately cross-vendor model that
# both finds alongside the primary model for recall and must agree before a candidate
# is refuted for precision. With CODEJURY_SECONDARY_MODEL unset, both roles collapse to
# the primary model: the finder is single-model and the verify stage keeps every
# candidate, the recall-safe default. Set a different model to enable cross-model
# verification, the same effect as the --secondary-model flag.
CODEJURY_SECONDARY_MODEL=a-different-model
CODEJURY_SECONDARY_PROVIDER=openai          # default openai
CODEJURY_SECONDARY_API_KEY=your_key_here
CODEJURY_SECONDARY_API_BASE=https://your-secondary-endpoint   # optional
CODEJURY_SECONDARY_WIRE_API=responses       # openai wire api, responses or chat. Default responses.

# Adversarial Diff Review roles, optional. When unset each falls back to CODEJURY_MODEL.
# Used by the Finder, Challenger, and Judge passes of adversarial mode.
CODEJURY_FINDER_MODEL=a-strong-model
CODEJURY_CHALLENGER_MODEL=a-different-model
CODEJURY_JUDGE_MODEL=a-different-model

# Request behavior, all optional with the defaults shown.
CODEJURY_RETRIES=2                # retries on a failed model call
CODEJURY_TIMEOUT=240              # per-call timeout in seconds
CODEJURY_HARD_TIMEOUT=180         # overall hard cap in seconds

# Repo Review with --reviewer claude-cli, optional. The reviewer shells out to Claude
# Code with read-only file tools.
CODEJURY_CLAUDE_BIN=claude        # path to the Claude Code binary. Default claude.
CODEJURY_CLAUDE_ARGS=             # extra args appended to the claude invocation
# CODEJURY_CLAUDE_UNSAFE_TOOLS is the one explicit way to hand tool selection to those
# extra args. Leave it unset. Setting it to 1 drops the read-only restriction and can
# turn a review into a writing agent, so only set it if you fully control the args.
# CODEJURY_CLAUDE_UNSAFE_TOOLS=1
