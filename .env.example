# Copy to .env. The CLI loads a working-directory .env at startup, so you do not need to
# source it, and a value already exported in the shell wins over the file. Every line is an
# optional override with its default shown, so uncomment only what you actually change. The
# default --executor auto runs a keyless Anthropic seat on your Claude Code subscription, so
# no provider key is required. Set a key below only to call the provider API instead.

# Provider key, read by each SDK. Set the one for your provider to call its API rather
# than the subscription. Leave both unset to run the default keyless Anthropic seat.
# ANTHROPIC_API_KEY=your_key_here   # --provider anthropic, the default
# OPENAI_API_KEY=your_key_here      # --provider openai

# Primary model backend. Defaults: provider anthropic, model claude-opus-4-8.
# CODEJURY_PROVIDER=anthropic     # anthropic, openai, or litellm
# CODEJURY_MODEL=claude-opus-4-8
# CODEJURY_API_KEY=...            # overrides the SDK key above
# CODEJURY_API_BASE=...           # a gateway or proxy endpoint, used with --provider openai or litellm
# CODEJURY_WIRE_API=chat          # chat or responses, only the openai reasoning models need responses

# Model roles, both review paths. finder finds, challenger refutes, judge confirms before a
# deletion. The rule is one line: an unset role field inherits the base backend above, so a
# single-model run sets none of these and you override only the seat you want to change.
#
# Each role takes the same five fields. Shown for finder, the same for CHALLENGER_ and JUDGE_:
# CODEJURY_FINDER_PROVIDER=...   # unset inherits CODEJURY_PROVIDER
# CODEJURY_FINDER_MODEL=...      # unset inherits CODEJURY_MODEL
# CODEJURY_FINDER_API_KEY=...    # inherits CODEJURY_API_KEY only when the provider matches base, a different vendor brings its own key
# CODEJURY_FINDER_API_BASE=...   # inherits CODEJURY_API_BASE only when the provider matches base
# CODEJURY_FINDER_WIRE_API=...   # unset inherits CODEJURY_WIRE_API, chat or responses
#
# Example, Claude base finds, GPT challenges, Claude confirms. Only the challenger is overridden,
# finder and judge inherit the base Claude, and the judge differs from the challenger so a
# deletion can be confirmed:
# CODEJURY_CHALLENGER_PROVIDER=openai
# CODEJURY_CHALLENGER_MODEL=a-real-openai-model    # the skeptic
# CODEJURY_CHALLENGER_API_KEY=...                  # a different vendor than base, so its own key
# CODEJURY_CHALLENGER_WIRE_API=responses
# A deletion needs the judge distinct from the challenger, with none distinct nothing is refuted,
# the recall-safe default. review repository --run finds with one model, --executor subscription
# ignores finder and challenger.

# Request behavior, optional, defaults shown.
# CODEJURY_RETRIES=2              # retries on a failed model call
# CODEJURY_TIMEOUT=240            # per-call deadline in seconds, also the retry hard cap

# Repository Review with --executor subscription, optional. Shells out to Claude Code with
# read-only file tools.
# CODEJURY_CLAUDE_BIN=claude     # path to the Claude Code binary
# CODEJURY_CLAUDE_ARGS=          # extra args appended to the claude invocation
# CODEJURY_CLAUDE_UNSAFE_TOOLS=1 # drops the read-only restriction, leave unset unless you control the args

# Subscription transport, optional. The keyless Anthropic seat runs each review through this.
# CODEJURY_CLAUDE_TRANSPORT=sdk       # the default, reuses a pooled session, process is one claude -p per model call
# CODEJURY_CLAUDE_SDK_POOL_SIZE=6     # sessions the sdk transport keeps warm, read only when transport is sdk
# CODEJURY_CLAUDE_SDK_MAX_TURNS=8     # max turns per sdk call, read only when transport is sdk

# EVM source fetch, optional. The evm domain pulls verified source from a block explorer by
# contract address when the source is not already on disk.
# CODEJURY_ETHERSCAN_API_KEY=...  # one key covers every chain, or pass --api-key
