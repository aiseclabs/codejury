# Copy to .env and `source .env`. The tool reads these from the environment, it does
# not auto-load .env. Set one provider key below. Everything else is an optional
# override with its default shown, so uncomment only what you actually change.

# Provider key, read by each SDK. Set the one for your provider.
ANTHROPIC_API_KEY=your_key_here   # --provider anthropic, the default
# OPENAI_API_KEY=your_key_here    # --provider openai

# Primary model backend. Defaults: provider anthropic, model claude-opus-4-8.
# CODEJURY_PROVIDER=anthropic     # anthropic, openai, or litellm
# CODEJURY_MODEL=claude-opus-4-8
# CODEJURY_API_KEY=...            # overrides the SDK key above
# CODEJURY_API_BASE=...           # a gateway or LiteLLM proxy, used with --provider litellm

# Model roles, both review paths. finder finds, challenger refutes, judge confirms before a
# deletion. Each field falls back to the base CODEJURY_PROVIDER/MODEL/API_KEY/API_BASE, so a
# single-model run sets none of these. Put a different vendor in any seat for cross-model review.
# A deletion needs the judge distinct from the challenger, with none distinct nothing is refuted,
# the recall-safe default. Example, Claude base finds, GPT challenges, Claude confirms:
# CODEJURY_CHALLENGER_PROVIDER=openai
# CODEJURY_CHALLENGER_MODEL=a-real-openai-model    # the skeptic
# CODEJURY_CHALLENGER_API_KEY=...
# CODEJURY_CHALLENGER_WIRE_API=responses           # responses or chat, default chat
# CODEJURY_JUDGE_MODEL=a-real-claude-model         # the confirmer, distinct from the challenger
# Finder and judge each take the same five fields, CODEJURY_FINDER_* and CODEJURY_JUDGE_*.
# review repo --run finds with one model, --reviewer claude-cli ignores finder and challenger.

# Request behavior, optional, defaults shown.
# CODEJURY_RETRIES=2              # retries on a failed model call
# CODEJURY_TIMEOUT=240           # per-call deadline in seconds, also the retry hard cap

# Repo Review with --reviewer claude-cli, optional. Shells out to Claude Code with
# read-only file tools.
# CODEJURY_CLAUDE_BIN=claude     # path to the Claude Code binary
# CODEJURY_CLAUDE_ARGS=          # extra args appended to the claude invocation
# CODEJURY_CLAUDE_UNSAFE_TOOLS=1 # drops the read-only restriction, leave unset unless you control the args
